    // --- 2. CSC COMPATIBILITY: HD sheets over the CSC mod's own portrait names ---
    // Covers `changePortrait Caroline FlowerDance` (its DancePractice event) and any CSC Appearance entry that
    // still wins, so a 64px sheet never shows under RoshiHD_Template. Exclusive beats CSC's "High" loads.
    {
      "LogName": "CSC Compatibility - HD Portraits",
      "Action": "Load",
      "Priority": "Exclusive",
      "Target": "Portraits/Caroline_Spring, Portraits/Caroline_Summer, Portraits/Caroline_Fall, Portraits/Caroline_Winter_Indoor, Portraits/Caroline_Winter_Outdoor, Portraits/Caroline_Aerobics, Portraits/Caroline_Beach, Portraits/Caroline_FlowerDance, Portraits/Caroline_SpiritsEve",
      "FromFile": "assets/Roshi_Portraits/Caroline_Sweetheart/{{TargetWithoutPath}}.png",
      "When": { "Enable Childhood Sweetheart Caroline Compatibility": "true" }
    },

