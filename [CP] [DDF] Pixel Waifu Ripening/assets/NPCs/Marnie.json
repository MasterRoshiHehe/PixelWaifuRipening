    // --- 2. APPEARANCE LOGIC ---
    // All appearance entries are consolidated here.
    // By using Game State Queries (like TIME) directly in the 'Condition' field,
    // the game engine evaluates these rules natively.
    // Note: The game only rechecks an NPC's Appearance when they change location.
    // This means if you are in the same room as Marnie when the time changes,
    // her portrait might not update until she moves or you re-enter the location.
    {
      "LogName": "Marnie Appearance Logic",
      "Action": "EditData",
      "Target": "Data/Characters",
      "TargetField": [ "Marnie", "Appearance" ],
      "Entries": {
        "Roshi_Marnie_Vanilla_Fallback": {
          "Id": "Roshi_Marnie_Vanilla_Fallback",
          "Portrait": "Portraits/Marnie",
          "Precedence": 100
        },
        "Roshi_Marnie_Rain": {
          "Id": "Roshi_Marnie_Rain",
          "Indoors": false,
          "Outdoors": true,
          "Condition": "WEATHER Town Rain Storm, ANY \"SEASON Spring\" \"SEASON Summer\" \"SEASON Fall\"",
          "Portrait": "Portraits/Marnie_Rainy",
          "Precedence": 50
        },
        "Roshi_Marnie_IslandAttire": {
